# Bu dosyayı .env olarak kopyala: cp .env.example .env
# Gerçek .env dosyasını asla git'e ekleme.

# Oturum çerezlerini imzalar. Yayına almadan önce rastgele, uzun bir değer yap:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=gelistirme-ortami-anahtari
# HTTPS üzerinde yayındayken true yap (çerez sadece şifreli bağlantıda gider).
SESSION_COOKIE_SECURE=false
# Kullanıcı sisteminden önceki verilerin kime taşınacağı. Boşsa ilk kayıt
# olan kullanıcıya gider.
LEGACY_DATA_OWNER_EMAIL=
DATABASE_URL=sqlite:///./creator_pulse.db

# Token şifreleme anahtarı (zorunlu, Instagram bağlantısı için gerekli).
# Üretmek için:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Bir kez üret ve değiştirme; değişirse kayıtlı token'lar çözülemez.
ENCRYPTION_KEY=

# YouTube Data API v3 anahtarı
YOUTUBE_API_KEY=

# Instagram API with Instagram Login
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:8000/connect/instagram/callback
